{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "crawler"
  },
  "Crawler": {
    "HubsFilePath": "../../seeds/hubs.json",
    "Defaults": {
      "MaxPages": 500,
      "MaxDepth": 6,
      "Workers": 8,
      "MinScoreToStore": 0.15,
      "MinScoreToExpand": 0.08,
      "MaxRuntimeMinutes": 30,
      "PerHostDelayMs": 1000,
      "ExplorationDepth": 3,
      "ExplorationLinksPerPage": 5,
      "ReuseFreshDays": 7
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
